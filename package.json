{
  "name": "malgyeol",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node scripts/serve-built.mjs",
    "build:data": "node scripts/build-dictionary.mjs",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test tests/rendered-html.test.mjs",
    "test:security": "node --test tests/security-config.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "ci": "npm run lint && npm run typecheck && npm run test:security && npm test"
  },
  "dependencies": {
    "@fontsource/hahmlet": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "lucide-react": "^1.29.0",
    "minisearch": "^7.2.0",
    "next": "^16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "1.51.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.33",
    "cross-env": "^10.1.0",
    "eslint": "10.8.0",
    "eslint-config-next": "^16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.2.1",
    "wrangler": "4.119.0"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  },
  "type": "module"
}

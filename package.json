{
  "name": "malgyeol",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node scripts/serve-built.mjs",
    "build:data": "node scripts/build-dictionary.mjs",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "ci": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fontsource/gowun-batang": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "lucide-react": "^1.27.0",
    "minisearch": "^7.2.0",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.12",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  },
  "type": "module"
}

{
  "name": "malgyeol",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node scripts/serve-built.mjs",
    "build:data": "node scripts/build-dictionary.mjs",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test tests/rendered-html.test.mjs",
    "test:security": "node --test tests/security-config.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "ci": "npm run lint && npm run typecheck && npm run test:security && npm test"
  },
  "dependencies": {
    "@fontsource/hahmlet": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "lucide-react": "^1.44.0",
    "minisearch": "^7.2.0",
    "next": "^16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/workers-types": "^5.20260910.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "cross-env": "^10.1.0",
    "eslint": "10.10.0",
    "eslint-config-next": "^16.3.4",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.3.0",
    "wrangler": "4.131.0"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  },
  "type": "module"
}
